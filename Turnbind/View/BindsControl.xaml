<UserControl
    x:Class="Turnbind.View.BindsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:generic="clr-namespace:System.Collections.Generic;assembly=netstandard"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Turnbind.Model"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:view="clr-namespace:Turnbind.View"
    xmlns:viewModel="clr-namespace:Turnbind.ViewModel"
    d:DataContext="{d:DesignInstance viewModel:BindsViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <DockPanel Grid.Column="1">
        <Border
            Margin="0,5,0,0"
            BorderBrush="Gray"
            BorderThickness="1"
            DockPanel.Dock="Bottom">
            <view:BindEditControl x:Name="BindEdit" />
        </Border>

        <ui:ListView
            Margin="0,0,0,5"
            BorderBrush="Gray"
            BorderThickness="1"
            DockPanel.Dock="Top"
            ItemsSource="{Binding KeyBinds, Mode=OneWay}"
            SelectedItem="{Binding Selected}">
            <ui:ListView.View>
                <ui:GridView AllowsColumnReorder="True">
                    <ui:GridView.Columns>
                        <ui:GridViewColumn
                            Width="Auto"
                            DisplayMemberBinding="{Binding Path=Key.KeysString, Mode=OneWay}"
                            Header="keys" />

                        <ui:GridViewColumn
                            Width="Auto"
                            DisplayMemberBinding="{Binding Path=Value.PixelPerMs, Mode=OneWay}"
                            Header="p/ms" />

                        <ui:GridViewColumn
                            Width="Auto"
                            DisplayMemberBinding="{Binding Path=Value.Dir, Mode=OneWay}"
                            Header="dir" />

                        <ui:GridViewColumn
                            Width="Auto"
                            DisplayMemberBinding="{Binding Path=Value.WheelFactor, Mode=OneWay}"
                            Header="factor" />
                    </ui:GridView.Columns>
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>
    </DockPanel>
</UserControl>
